# who is running. one persona per file in personas/, selected by id.
CLAWBUZZ_PERSONA=example
# where the persona files live (defaults to ./personas)
CLAWBUZZ_PERSONA_DIR=

# the identity anchors: a json array, one entry per person, handles per
# platform. real handles never live in the repo.
# [{"id":"friend","label":"the friend","handles":{"x":["@friend"],"email":["friend@example.com"]}}]
CLAWBUZZ_CONNECTIONS=

# the persona memory server (retelldb). unset means memory is off, with
# a warn, never a crash and never a guess.
CLAWBUZZ_RETELLDB_URL=
CLAWBUZZ_RETELLDB_KEY=

# platform credentials. each surface documents the ones it needs; none
# of them belong in the manifest and none of them belong in the repo.
